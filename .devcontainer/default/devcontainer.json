{
    "name": "Snowflake Document Agent",
    "image": "mcr.microsoft.com/devcontainers/python:3.13-trixie",
    "containerEnv": {
        "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:UV_PROJECT_ENVIRONMENT}/bin:${containerEnv:PATH}"
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.snowflake",
            "target": "/home/vscode/.snowflake",
            "type": "bind"
        }
    ],
    "updateContentCommand": "/usr/local/bin/python3 -m pip install uv && /home/vscode/.local/bin/uv sync"
}
